# URL of the t2c MCP backend (Render service, Cloudflare tunnel, or local).
BACKEND_URL=http://localhost:8080

# Shared secret for the backend's /mcp endpoint (server-side only; never
# NEXT_PUBLIC). Must match MCP_TOKEN on the backend. Leave unset for a local
# backend started without MCP_TOKEN.
MCP_TOKEN=

# OpenRouter API key (server-side only). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini API key (server-side only) — powers template RAG embeddings via
# gemini-embedding-001. Get one at https://aistudio.google.com/apikey (free tier).
# Leave blank to disable retrieval; the app still runs, just without template hints.
GOOGLE_GENERATIVE_AI_API_KEY=

# Langfuse LLM observability (server-side only). Create a project at
# https://us.cloud.langfuse.com and paste its keys here. Leave blank to disable
# tracing entirely — the app runs fine without it. US region base URL is required
# (the SDK defaults to the EU host).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# PostHog product analytics (behavioral events, funnels, session replay, flags).
# Create a project at https://us.posthog.com and paste its project API key (phc_...).
# The key is client-exposed (ingestion-only) — safe to ship. Leave blank to
# disable all product analytics; the app runs fine without it. US region host
# required to match the /ingest reverse proxy in next.config.js.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
