# URL of the t2c MCP backend (Render service, Cloudflare tunnel, or local).
BACKEND_URL=http://localhost:8080

# Shared secret for the backend's /mcp endpoint (server-side only; never
# NEXT_PUBLIC). Must match MCP_TOKEN on the backend. Leave unset for a local
# backend started without MCP_TOKEN.
MCP_TOKEN=

# OpenRouter API key (server-side only). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Langfuse LLM observability (server-side only). Create a project at
# https://us.cloud.langfuse.com and paste its keys here. Leave blank to disable
# tracing entirely — the app runs fine without it. US region base URL is required
# (the SDK defaults to the EU host).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
