# One public port ({$PORT}, injected by the host) fanned out to two local
# services inside the same container:
#   • MCP endpoints  -> FastMCP streamable-HTTP server on :9000  (Vercel calls these)
#   • everything else -> standalone ocp_vscode viewer on :3939   (browser iframe loads this)
#
# Catch-all -> viewer is deliberate: the viewer page (/viewer) also requests its
# own JS/CSS/websocket assets at other paths, so anything that isn't an MCP
# endpoint is routed to the viewer. reverse_proxy upgrades websockets automatically.
#
# header_up Host: rewrite the Host header to the upstream's local address. The
# public host (*.trycloudflare.com / *.onrender.com) otherwise trips the MCP
# server's DNS-rebinding protection (421) and makes the viewer error (500).

:{$PORT} {
	handle /mcp* {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host 127.0.0.1:9000
		}
	}
	handle /health {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host 127.0.0.1:9000
		}
	}
	handle /export* {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host 127.0.0.1:9000
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3939 {
			header_up Host 127.0.0.1:3939
		}
	}
}
